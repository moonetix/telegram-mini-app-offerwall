# Copy to .env and fill in. Never commit .env.

# From @BotFather. Server only.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Random string, 1 to 256 characters from A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# Public https address of this server. The Mini App is served at PUBLIC_URL/
PUBLIC_URL=https://miniapp.example.com

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Optional
PORT=3000
DATABASE_PATH=./data.sqlite
INIT_DATA_MAX_AGE=3600
CURRENCY_NAME=Coins
